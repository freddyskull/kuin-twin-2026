generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  password         String
  role             Role       @default(CUSTOMER)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  bookings         Booking[]
  favorites        Favorite[]
  media            Media[]
  receivedMessages Message[]  @relation("ReceivedMessages")
  sentMessages     Message[]  @relation("SentMessages")
  profile          Profile?
  reviews          Review[]   @relation("UserReviews")
  services         Service[]
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Media {
  id        String   @id @default(uuid())
  url       String
  key       String?
  fileName  String
  mimeType  String
  size      Int
  alt       String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Profile {
  id              String                    @id @default(uuid())
  userId          String                    @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  location        Unsupported("geography")?
  serviceRadiusKm Int                       @default(10)
  ratingAvg       Decimal                   @default(0) @db.Decimal(3, 2)
  reviewsCount    Int                       @default(0)
  businessHours   Json?
  isVerified      Boolean                   @default(false)
  facebook        String?
  instagram       String?
  linkedin        String?
  phone           String?
  starsRatio      Int                       @default(0)
  tiktok          String?
  twitter         String?
  website         String?
  whatsapp        String?
  youtube         String?
  companyId       String?
  portfolio       PortfolioItem[]
  company         Company?                  @relation(fields: [companyId], references: [id])
  user            User                      @relation(fields: [userId], references: [id])
}

model Company {
  id                 String    @id @default(uuid())
  businessName       String
  logoUrl            String?
  description        String?
  rfc                String    @unique
  legalName          String
  fiscalRegime       String
  taxAddress         String
  taxAddressZip      String
  taxAddressCity     String
  taxAddressState    String
  taxAddressCounty   String?
  isSatVerified      Boolean   @default(false)
  satVerifiedAt      DateTime?
  satVerificationDoc String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  isActive           Boolean   @default(true)
  satCertificateUrl  String?
  branches           Branch[]
  profiles           Profile[]
  services           Service[]
}

model Branch {
  id            String                    @id @default(uuid())
  companyId     String
  name          String
  isMain        Boolean                   @default(false)
  description   String?
  phone         String?
  whatsapp      String?
  email         String?
  address       String
  addressLine2  String?
  city          String
  state         String
  county        String?
  zipCode       String
  country       String                    @default("México")
  location      Unsupported("geography")?
  addressNotes  String?
  /// @zod.custom.use(z.any())
  businessHours Json?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  isActive      Boolean                   @default(true)
  company       Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  services      Service[]                 @relation("BranchToService")
}

model PortfolioItem {
  id                String   @id @default(uuid())
  profileId         String
  imageUrl          String
  description       String?
  dynamicAttributes Json?
  imageGallery      String[] @default([])
  profile           Profile  @relation(fields: [profileId], references: [id])
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  parentId    String?
  description String?
  imageUrl    String?
  isActive    Boolean    @default(true)
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  services    Service[]
}

model ServiceUnit {
  id           String    @id @default(uuid())
  name         String    @unique
  abbreviation String    @unique
  services     Service[]
}

model Service {
  id                String                    @id @default(uuid())
  vendorId          String
  categoryId        String
  unitId            String?
  title             String
  basePrice         Decimal?                  @db.Decimal(10, 2)
  dynamicAttributes Json?
  description       String?
  imageUrl          String?
  isActive          Boolean                   @default(true)
  workSchedule      Json?
  slug              String                    @unique
  tags              String[]                  @default([])
  commentsBox       Json?
  companyId         String?
  location          Unsupported("geography")?
  reviewsCount      Int                       @default(0)
  showPrice         Boolean                   @default(true)
  starsRate         Decimal                   @default(0) @db.Decimal(3, 2)
  imageGallery      String[]                  @default([])
  address           String?
  latitude          Float?
  longitude         Float?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  bookings          Booking[]
  favorites         Favorite[]
  reviews           Review[]
  category          Category                  @relation(fields: [categoryId], references: [id])
  company           Company?                  @relation(fields: [companyId], references: [id])
  unit              ServiceUnit?              @relation(fields: [unitId], references: [id])
  vendor            User                      @relation(fields: [vendorId], references: [id])
  faqs              ServiceFaq[]
  metadata          ServiceMetadata[]
  slots             ServiceSlot[]
  branches          Branch[]                  @relation("BranchToService")

  @@unique([vendorId, title])
  @@index([companyId])
}

model Review {
  id        String   @id @default(uuid())
  content   String?
  rating    Int      @default(5)
  serviceId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
}

model ServiceMetadata {
  id        String  @id @default(uuid())
  serviceId String
  key       String
  value     String
  service   Service @relation(fields: [serviceId], references: [id])
}

model ServiceFaq {
  id        String  @id @default(uuid())
  serviceId String
  question  String
  answer    String
  order     Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Booking {
  id            String          @id @default(uuid())
  customerId    String
  serviceId     String
  status        BookingStatus   @default(PENDING)
  scheduledDate DateTime
  notes         String?
  customer      User            @relation(fields: [customerId], references: [id])
  service       Service         @relation(fields: [serviceId], references: [id])
  details       BookingDetails?
  payment       Payment?
  slots         ServiceSlot[]
}

model BookingDetails {
  id              String  @id @default(uuid())
  bookingId       String  @unique
  serviceSnapshot Json
  unitPrice       Decimal @db.Decimal(10, 2)
  quantity        Int     @default(1)
  taxTotal        Decimal @db.Decimal(10, 2)
  grandTotal      Decimal @db.Decimal(10, 2)
  booking         Booking @relation(fields: [bookingId], references: [id])
}

model ServiceSlot {
  id          String     @id @default(uuid())
  serviceId   String
  bookingId   String?
  startTime   DateTime
  endTime     DateTime
  status      SlotStatus @default(AVAILABLE)
  isRecurring Boolean    @default(false)
  booking     Booking?   @relation(fields: [bookingId], references: [id])
  service     Service    @relation(fields: [serviceId], references: [id])
}

model Payment {
  id          String  @id @default(uuid())
  bookingId   String  @unique
  amount      Decimal @db.Decimal(10, 2)
  processorId String
  status      String
  booking     Booking @relation(fields: [bookingId], references: [id])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now())
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

enum BookingStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}
